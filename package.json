{
  "name": "my-dsh-message-search",
  "version": "0.3.12",
  "license": "MIT",
  "description": "跨会话消息检索：Ctrl+F 打开，按当前会话 / 工作区 / 全部会话检索消息正文",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myhylijp/my-dsh-message-search.git"
  },
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
